generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  username      String?           @unique
  email         String?           @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String            @default("CLIENTE") // CLIENTE, CAMARERO, COCINA, GERENTE, ADMIN

  // Campos para gestión de plantilla y cuadrantes
  contractHours Int               @default(40) // Horas contratadas por semana (40, 30, 20, 15)
  preference    String            @default("FULL") // FULL, WEEKEND_ONLY, WEEKDAY_ONLY, MORNING_ONLY, NIGHT_ONLY
  colorTag      String?           // Color distintivo para el cuadrante (#9E2A2B, #2563EB, etc.)
  isActive      Boolean           @default(true)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orders        Order[]
  shifts        ShiftAssignment[]

  @@index([username])
  @@index([email])
  @@index([role])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  icon        String
  description String?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id           String            @id @default(cuid())
  name         String
  description  String
  ingredients  String            // JSON encoded array of ingredient strings or description
  price        Float
  format       String            // e.g. "100grs", "Unidad", "Copa", "Caña", "Tapa", "Mollete"
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageUrl     String
  rating       Float             @default(5.0)
  totalReviews Int               @default(0)
  isAvailable  Boolean           @default(true)
  badge        String?           // e.g. "Cruzcampo Glaciar", "100% Bellota", "Imprescindible"
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  allergens    ProductAllergen[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
}

model Allergen {
  id         String            @id @default(cuid())
  code       String            @unique // e.g. "GLUTEN", "LACTEOS", "PESCADO", "HUEVOS"
  name       String            // e.g. "Gluten", "Lácteos", "Pescado", "Huevos"
  icon       String?           // Lucide icon name or svg
  badgeColor String?
  products   ProductAllergen[]
}

model ProductAllergen {
  id         String   @id @default(cuid())
  productId  String
  allergenId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([productId, allergenId])
  @@index([productId])
  @@index([allergenId])
}

model StaffUser {
  id        String   @id @default(cuid())
  name      String
  pinHash   String   // Hash or encrypted pin code (e.g. "1234")
  role      String   @default("CAMARERO") // GERENTE, CAMARERO, COCINA
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model RestaurantTable {
  id          String   @id @default(cuid())
  tableNumber String   @unique // e.g. "Mesa 1", "Barra 2", "Terraza 3"
  name        String   // Display label
  zone        String   @default("SALON") // "SALON", "BARRA", "TERRAZA"
  seats       Int      @default(4)
  posX        Float    @default(50.0) // 0-100 percentage in 2D floor plan
  posY        Float    @default(50.0) // 0-100 percentage in 2D floor plan
  shape       String   @default("ROUND") // "ROUND", "SQUARE", "RECTANGLE", "BAR_STOOL"
  color       String?  // custom hex color or zone default
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([zone])
}

model Order {
  id          String           @id @default(cuid())
  orderNumber String           @unique // e.g. "Q-101"
  tableNumber String           // e.g. "Mesa 4 (Terraza)", "Barra 2"
  tableId     String?
  table       RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  pax         Int              @default(2) // número de comensales en mesa
  status      String           @default("PENDING") // PENDING, PREPARING, SERVED, PAID, CANCELLED
  notes       String?
  totalAmount Float            @default(0.0)
  staffUserId String?
  staffUser   StaffUser?       @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([tableId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  unitPrice Float
  notes     String?

  @@index([orderId])
  @@index([productId])
}

model WeeklySchedule {
  id            String            @id @default(cuid())
  weekStartDate DateTime          // Fecha del lunes de la semana correspondiente (00:00:00)
  notes         String?
  demandConfig  String?           // JSON string: Previsión de demanda diaria (Fácil, Difícil/Buya, Intermedio) y plantilla requerida
  isPublished   Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  shifts        ShiftAssignment[]

  @@unique([weekStartDate])
  @@index([weekStartDate])
}

model ShiftAssignment {
  id         String         @id @default(cuid())
  scheduleId String
  schedule   WeeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek  Int            // 1=Lunes (Cerrado), 2=Martes, 3=Miércoles, 4=Jueves, 5=Viernes, 6=Sábado, 7=Domingo
  shiftType  String         // LUNCH (12-16), DINNER (20-00), DOUBLE (12-16 y 20-00), OFF (Libre)
  hours      Float          @default(4.0)

  @@unique([scheduleId, userId, dayOfWeek])
  @@index([scheduleId])
  @@index([userId])
}

// ==========================================
// MÓDULO DE STOCK, PROVEEDORES & MERMAS
// ==========================================

model Supplier {
  id               String          @id @default(cuid())
  name             String
  contactName      String?
  phone            String          // Teléfono para pedidos directos vía WhatsApp
  orderDays        String          // Días habituales de pedido (ej: "Lunes y Miércoles")
  deliveryDays     String?         // Días/horarios de entrega (ej: "Martes y Jueves 8:00")
  defaultOrderText String?         // Lista típica o notas de pedido recurrente
  notes            String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  supplies         SupplyItem[]
  prices           SupplierPrice[]

  @@index([name])
}

model SupplyItem {
  id                String          @id @default(cuid())
  name              String
  category          String          // CARNES, PESCADOS, QUESOS, FRUTAS_VERDURAS, PANADERIA, BEBIDAS, ACEITES_SALSAS, ENVASES_LIMPIEZA
  currentStock      Float           @default(0.0)
  minStock          Float           @default(5.0)  // Umbral mínimo de seguridad
  unit              String          // kg, litros, cajas, unidades, sacos, cartones, botes
  currentPrice      Float           @default(0.0)  // Precio de coste actual (€/unidad)
  primarySupplierId String?
  primarySupplier   Supplier?       @relation(fields: [primarySupplierId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  prices            SupplierPrice[]
  movements         StockMovement[]
  wastes            FoodWaste[]

  @@index([category])
  @@index([primarySupplierId])
}

model SupplierPrice {
  id                String      @id @default(cuid())
  supplyItemId      String
  supplyItem        SupplyItem  @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  unitPrice         Float       // Cotización del proveedor (€)
  formatDescription String?     // Formato de venta (ej: "Caja 10kg", "Saco 25kg", "Garrafa 5L")
  isBestOffer       Boolean     @default(false)
  lastUpdated       DateTime    @default(now())

  @@unique([supplyItemId, supplierId])
  @@index([supplyItemId])
  @@index([supplierId])
}

model StockMovement {
  id           String      @id @default(cuid())
  supplyItemId String
  supplyItem   SupplyItem  @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)
  type         String      // IN (Recepción de compra), OUT (Consumo cocina/barra), ADJUSTMENT (Conteo manual), WASTE (Merma)
  quantity     Float       // Cantidad (+ o -)
  reason       String?     // Motivo del movimiento
  loggedBy     String?     // Nombre del empleado que registró el movimiento
  createdAt    DateTime    @default(now())

  @@index([supplyItemId])
  @@index([createdAt])
}

model FoodWaste {
  id            String      @id @default(cuid())
  supplyItemId  String?
  supplyItem    SupplyItem? @relation(fields: [supplyItemId], references: [id], onDelete: SetNull)
  itemName      String      // Nombre del producto o plato desechado
  quantity      Float       // Cantidad desechada
  unit          String      // kg, raciones, unidades, litros
  estimatedCost Float       @default(0.0) // Pérdida económica calculada (€)
  reason        String      // EXPIRED (Caducado), SPOILED (Deteriorado fresco), COOKING_ERROR (Fallo cocina/quemado), LEFTOVER (Sobrante servicio), OTHER
  loggedBy      String?
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([supplyItemId])
  @@index([createdAt])
  @@index([reason])
}

model LocalEvent {
  id               String   @id @default(cuid())
  title            String   // ej: "Feria y Fiestas de Camas", "Paso de Hermandades del Rocío", "Derbi Sevillano"
  description      String?
  location         String   @default("Camas / Sevilla")
  startDate        DateTime
  endDate          DateTime
  eventType        String   // FERIA_CAMAS, ROCIO_PASO, SEMANA_SANTA, FERIA_ABRIL, FUTBOL_DERBI, FESTIVO, CALOR
  demandMultiplier Float    @default(1.5) // Multiplicador de previsión de afluencia (ej: 2.0 = +100%)
  recommendedFocus String?  // Insumos y bebidas críticas a reforzar (ej: "Barriles Cruzcampo, Jamón, Pan mollete")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([startDate])
  @@index([eventType])
}
